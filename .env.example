# Postgres connection string. For local development you can run Postgres in
# Docker (`docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 postgres:16`)
# or install it locally. For a free hosted database (e.g. to deploy on
# Vercel), use Neon (neon.tech) or Supabase (supabase.com) and paste the
# connection string they give you here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/maidtracker"
JWT_SECRET="change-me-to-a-long-random-string"
