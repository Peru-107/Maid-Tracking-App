generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  EMPLOYER
  HELPER
  RESIDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  PAID_LEAVE
}

// What kind of staff a HelperProfile represents. MAID is the default so
// existing rows need no backfill. Salary/attendance calculation currently
// treats every category the same as MAID (monthly base + attendance) --
// GARDENER is expected to need a different pay model later, but that's a
// deliberate follow-up, not designed yet.
enum HelperCategory {
  MAID
  COOK
  GARDENER
  GARBAGE_COLLECTOR
  WATCHMAN
}

// Only meaningful when category == WATCHMAN. Day/night coverage is modeled
// as two separate HelperProfile rows (one per shift), each self-marking
// their own attendance -- not a shared roster.
enum Shift {
  DAY
  NIGHT
}

enum VisitorPurpose {
  GUEST
  DELIVERY
  CAB
  VENDOR
  STAFF
  OTHER
}

// Phone + OTP login. In production, codeHash would be sent via an SMS
// gateway (e.g. MSG91/Twilio); here it is generated and surfaced in dev
// mode only (see src/lib/otp.ts).
model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone])
}

model User {
  id           String   @id @default(cuid())
  phone        String   @unique
  name         String?
  role         Role
  languagePref String   @default("en")
  createdAt    DateTime @default(now())

  // Present when role == EMPLOYER: the helpers this employer manages. Also
  // used when this EMPLOYER account is really a society admin -- the same
  // ownership model covers watchmen/gardeners/garbage collectors too.
  managedHelpers HelperProfile[] @relation("EmployerHelpers")

  // Present when role == HELPER, once the helper has logged in and linked
  // their account to the profile the employer created for them.
  helperProfile HelperProfile? @relation("HelperUser")

  // Present when role == EMPLOYER and this account is a society admin: the
  // residents (flats) they've registered.
  managedResidents ResidentProfile[] @relation("EmployerResidents")

  // Present when role == RESIDENT, once the resident has logged in and
  // linked their account to the profile the admin created for them.
  residentProfile ResidentProfile? @relation("ResidentUser")

  // Present when role == EMPLOYER and this account is a society admin: the
  // full gate log across all flats.
  visitorEntries VisitorEntry[] @relation("EmployerVisitorEntries")
}

model HelperProfile {
  id                String    @id @default(cuid())
  employerId        String
  employer          User      @relation("EmployerHelpers", fields: [employerId], references: [id], onDelete: Cascade)
  userId            String?   @unique
  user              User?     @relation("HelperUser", fields: [userId], references: [id])
  name              String
  phone             String
  baseMonthlySalary Float
  // UPI VPA (e.g. "name@bank") the employer pays salary to. Optional --
  // helpers who are paid in cash never set one. Validated in the API layer
  // (src/lib/upi.ts); never trusted as pre-sanitized when read back out.
  upiId             String?
  category          HelperCategory @default(MAID)
  shift             Shift?
  active            Boolean   @default(true)
  joinedAt          DateTime  @default(now())
  createdAt         DateTime  @default(now())

  attendanceLogs AttendanceLog[]
  loans          LoanEntry[]
  kharchas       KharchaEntry[]
  settlements    MonthlySettlement[]
  // Gate log entries logged by this profile, when category == WATCHMAN.
  loggedVisitorEntries VisitorEntry[]

  @@index([employerId])
}

model AttendanceLog {
  id                 String            @id @default(cuid())
  helperId           String
  helper             HelperProfile     @relation(fields: [helperId], references: [id], onDelete: Cascade)
  date               DateTime
  status             AttendanceStatus
  badli              Boolean           @default(false)
  markedByHelper     Boolean           @default(false)
  approvedByEmployer Boolean           @default(false)
  note               String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([helperId, date])
  @@index([helperId, date])
}

model LoanEntry {
  id                 String    @id @default(cuid())
  helperId           String
  helper             HelperProfile @relation(fields: [helperId], references: [id], onDelete: Cascade)
  amount             Float
  reason             String?
  monthlyEmi         Float
  remainingPrincipal Float
  date               DateTime  @default(now())
  closed             Boolean   @default(false)
  createdAt          DateTime  @default(now())

  emiEvents LoanEmiEvent[]

  @@index([helperId])
}

// One row per month a loan was considered for settlement: records whether
// the EMI was deducted or skipped that month, so history is auditable.
model LoanEmiEvent {
  id           String    @id @default(cuid())
  loanId       String
  loan         LoanEntry @relation(fields: [loanId], references: [id], onDelete: Cascade)
  month        Int
  year         Int
  amountDue    Float
  skipped      Boolean   @default(false)
  amountPaid   Float
  createdAt    DateTime  @default(now())

  @@unique([loanId, month, year])
}

model KharchaEntry {
  id           String              @id @default(cuid())
  helperId     String
  helper       HelperProfile       @relation(fields: [helperId], references: [id], onDelete: Cascade)
  amount       Float
  reason       String?
  date         DateTime            @default(now())
  settled      Boolean             @default(false)
  settlementId String?
  settlement   MonthlySettlement?  @relation(fields: [settlementId], references: [id])
  createdAt    DateTime            @default(now())

  @@index([helperId])
}

model MonthlySettlement {
  id               String    @id @default(cuid())
  helperId         String
  helper           HelperProfile @relation(fields: [helperId], references: [id], onDelete: Cascade)
  month            Int
  year             Int

  baseSalary       Float
  totalDaysInMonth Int
  presentDays      Float
  absentDays       Float
  halfDays         Float
  paidLeaveDays    Float
  perDayWage       Float
  lossOfPay        Float

  loanEmiDue       Float     @default(0)
  loanEmiDeducted  Float     @default(0)

  kharchaDeducted  Float     @default(0)
  overtimeBonus    Float     @default(0)
  festivalBonus    Float     @default(0)

  finalPayout      Float

  paid             Boolean   @default(false)
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  kharchas KharchaEntry[]

  @@unique([helperId, month, year])
  @@index([helperId])
}

// A flat/unit in a society, registered by the admin. Mirrors HelperProfile's
// ownership shape: created by the admin, later linked to a User once the
// resident logs in with the phone number the admin registered for them.
model ResidentProfile {
  id         String   @id @default(cuid())
  employerId String
  employer   User     @relation("EmployerResidents", fields: [employerId], references: [id], onDelete: Cascade)
  userId     String?  @unique
  user       User?    @relation("ResidentUser", fields: [userId], references: [id])
  name       String
  // Nullable so an admin can pre-register a flat before the actual
  // resident's phone number is known (bulk wing/floor setup) -- the OTP
  // auto-link on first login only ever matches a non-null phone anyway.
  phone      String?
  flatNumber String
  // Nullable -- a wing/block label (e.g. "A") set by the bulk-add form or
  // the admin manually, used to build a wing-then-flat picker at the gate.
  // Flats with no wing fall back to an "ungrouped" bucket in that picker.
  wing       String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([employerId])
  @@index([employerId, flatNumber])
}

// One row per visitor logged at the gate. flatNumber is a plain string
// (matched against ResidentProfile.flatNumber for resident-side filtering)
// rather than a hard FK, so a watchman can still log an entry for a flat
// that hasn't been registered as a resident yet. Never deleted in bulk --
// this is meant to stay a permanent, searchable ledger. loggedById is
// nullable with SetNull so removing a watchman's profile later never
// erases gate log history.
model VisitorEntry {
  id          String         @id @default(cuid())
  employerId  String
  employer    User           @relation("EmployerVisitorEntries", fields: [employerId], references: [id], onDelete: Cascade)
  flatNumber  String
  visitorName String
  purpose     VisitorPurpose
  // Only meaningful (and shown) when purpose == OTHER -- the free-text
  // description the watchman types in for that one purpose.
  note        String?
  entryTime   DateTime       @default(now())
  loggedById  String?
  loggedBy    HelperProfile? @relation(fields: [loggedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())

  @@index([employerId, flatNumber])
  @@index([employerId, entryTime])
}
